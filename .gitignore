# ==============================================================================
# DrishtiPharma - Git Ignore Rules
# ==============================================================================

# 1. Environment & Secret Credentials (NEVER COMMIT LIVE KEYS)
.env
.env.*
*.env
!.env.example

# 2. Python Bytecode & Cache Artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# 3. Virtual Environments
venv/
env/
ENV/
env.bak/
venv.bak/
.venv/

# 4. Audio Synthesis Runtime Cache
core/audio_cache/*.wav
core/audio_cache/*.mp3
!core/audio_cache/.gitkeep

# 5. Microsoft Word Lock Files
~$*.docx
~$*.doc

# 6. Operating System & Editor Files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# 7. Logs & Temporary Execution Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
