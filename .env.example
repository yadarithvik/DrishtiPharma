# ==============================================================================
# DrishtiPharma - Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your API credentials:
#   copy .env.example .env (Windows)
#   cp .env.example .env (Linux/macOS)
# ==============================================================================

# 1. Google Gemini Multimodal Vision API Key (Primary Vision Engine)
# Obtain a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. NVIDIA NIM API Key (Failover Vision & Nemotron Conversational Voice Agent)
# Obtain free credits at: https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_nim_api_key_here

# 3. Server Configuration (Optional defaults)
HOST=0.0.0.0
PORT=8080
DEBUG=False
